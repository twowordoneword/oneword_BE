# .env 로 복사한 뒤 실제 값을 채운다. (.env 는 커밋 금지)
#   set -a; source .env; set +a; ./gradlew bootRun
SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:mysql://localhost:3306/musing?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=musing
DB_PASSWORD=musing

CORS_ALLOWED_ORIGIN_PATTERNS=*

APP_JWT_SECRET=local-dev-jwt-secret-change-this-at-least-32-bytes
APP_ACCESS_TOKEN_SECONDS=3600
APP_REFRESH_TOKEN_SECONDS=1209600

# id_token의 aud 검증값. 플랫폼마다 다르면 콤마로 나열한다.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
