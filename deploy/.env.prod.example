# EC2의 ~/musing/.env 로 복사해 값을 채운다.  chmod 600 .env  (커밋 금지)
# 값이 규칙을 어기면 ProductionConfigGuard가 기동을 막는다 — README "운영 설정 점검" 참고.

# nginx 인증서·server_name에 쓰는 도메인
DOMAIN=api.example.com

# RDS 접속 정보
DB_URL=jdbc:mysql://<rds-endpoint>:3306/musing?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&sslMode=REQUIRED
DB_USERNAME=musing
DB_PASSWORD=

# 프론트 출처. 앱만 쓰고 웹이 없으면 실제 서비스 도메인 하나만 둔다. '*' 금지.
CORS_ALLOWED_ORIGIN_PATTERNS=https://example.com

# openssl rand -base64 48
APP_JWT_SECRET=
APP_ACCESS_TOKEN_SECONDS=1800
APP_REFRESH_TOKEN_SECONDS=1209600

# 비워 두면 그 제공자만 비활성. 플랫폼마다 다르면 콤마로 나열.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 배치 수동 트리거용. 비우면 관리자 API가 항상 거부된다.  openssl rand -hex 32
ADMIN_TOKEN=
# FreqBlog 감정값 수집용(선택)
FREQBLOG_API_KEY=
