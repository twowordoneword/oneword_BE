# ${DOMAIN}은 컨테이너 기동 시 환경변수로 치환된다. nginx 변수($host 등)는 그대로 남는다.

# 로그인·토큰 재발급은 인증 없이 열려 있고, 요청마다 외부 소셜 API를 부른다.
# IP당 분당 10회(순간 5회 여유)로 막아 무차별 대입과 외부 API 소진을 방지한다.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
# 그 외 API는 넉넉하게 — 비정상적으로 많은 요청만 끊는다.
limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
limit_req_status 429;

upstream musing_app {
    server app:8080;
}

server {
    listen 80;
    server_name ${DOMAIN};

    # Let's Encrypt 갱신용
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;

    server_tokens off;
    # 일기 본문 5000자 + 곡 정보 정도라 1MB면 충분하다.
    client_max_body_size 1m;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 30s;

    # 관리자 배치 API는 공유 토큰 하나로만 보호되므로 인터넷에 노출하지 않는다.
    # 운영자는 SSH로 접속해 localhost:8080 으로 직접 호출한다.
    location /api/v1/admin/ {
        return 404;
    }

    location ~ ^/api/v1/auth/(login|refresh)$ {
        limit_req zone=auth burst=5 nodelay;
        proxy_pass http://musing_app;
    }

    location /api/ {
        limit_req zone=api burst=20 nodelay;
        proxy_pass http://musing_app;
    }

    location / {
        return 404;
    }
}
